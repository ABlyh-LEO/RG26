# 统一换行符：仓库内一律存 LF，避免 Windows 开发者提交 CRLF 导致
# CI（Linux）出现整文件差异，也避免 eslint/prettier 报错。
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.docx binary
*.zip binary

# 锁文件与文档保持 LF
package-lock.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# GitHub 语言统计：把生成产物排除在外
public/data/event.json linguist-generated=true
